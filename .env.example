# --- LLM / VLM (OpenAI-compatible endpoint, Yandex Cloud AI Studio by default) ---
LLM_API_KEY=
LLM_FOLDER_ID=
# Optional override of config.yaml llm.base_url
# LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1

# --- Image generation (GigaChat / Kandinsky) ---
# Authorization key from https://developers.sber.ru/studio (base64 of client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Paths ---
# DATA_DIR=./data
# SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
