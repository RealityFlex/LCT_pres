{
  "$description": "Дизайн-токены сети кофеен «Зерно» (W3C Design Tokens)",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#C8582A",
        "$description": "Обжарка — основной: логотип, акценты, главная серия диаграмм"
      },
      "secondary": {
        "$type": "color",
        "$value": "#2F7A55",
        "$description": "Лист — второй: сравнение, вторая серия"
      },
      "accent": {
        "$type": "color",
        "$value": "#E8A33D",
        "$description": "Мёд — акцент: одна точка внимания на слайде"
      }
    },
    "background": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Белый — фон контентных слайдов"
    },
    "surface": {
      "$type": "color",
      "$value": "#F6EFE7",
      "$description": "Сливки — подложки карточек"
    },
    "dark": {
      "$type": "color",
      "$value": "#2B1A14",
      "$description": "Эспрессо — тёмный фон обложки и разделов"
    },
    "text": {
      "$type": "color",
      "$value": "#1F1A17",
      "$description": "Текст — основной текст"
    },
    "muted": {
      "$type": "color",
      "$value": "#7B6F66",
      "$description": "Пенка — подписи, оси, второстепенный текст"
    }
  },
  "font": {
    "heading": {
      "$type": "fontFamily",
      "$value": [
        "Manrope",
        "Arial",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Golos Text",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "typography": {
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.heading}",
        "fontSize": "40px",
        "fontWeight": 700
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "16px",
        "fontWeight": 400
      }
    }
  },
  "spacing": {
    "margin": {
      "$type": "dimension",
      "$value": "72px",
      "$description": "поля слайда 960×540"
    },
    "gap": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "зазор между блоками"
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "12px"
    }
  },
  "logo": {
    "minHeight": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "минимальная высота логотипа на слайде 960×540"
    },
    "clearSpace": {
      "$type": "number",
      "$value": 0.5,
      "$description": "охранное поле — половина высоты логотипа"
    }
  }
}